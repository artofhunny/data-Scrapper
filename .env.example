# Apni Gemini API key yahan daalein (FREE hai) - aistudio.google.com/apikey se milegi
GEMINI_API_KEY=your_api_key_here

# Kitne mechanic listings target karni hain per search
TARGET_RESULTS=25

# Headless mode: true = background me chalega, false = browser dikhega (debug ke liye achha)
HEADLESS=true
PORT=3000
# Kam se kam kitni listings me email chahiye (agent itni emails milne tak aur listings check karega)
EMAIL_TARGET=15

# Email dhoondne ke liye maximum kitni Google Maps listings scan karni hain
MAX_SCAN_RESULTS=60
